# Copy to .env (gitignored) and fill in. Never commit real values.

# excel = HASBAH_CUSTOMERS_SUBD_VANS.xlsx (offline/dev) | mssql = live SQL Server feed
DATA_SOURCE=mssql
MONTHS_BACK=8           # full months shown; 8 keeps the Excel SUBD months (Jan–Apr 26) in view
CACHE_TTL_HOURS=20      # mssql cache lifetime; keep < 24 so the daily restart always refreshes

MSSQL_HOST=192.168.0.237
MSSQL_PORT=1433
MSSQL_DB=VANS_WH
MSSQL_USER=vans
MSSQL_PASSWORD="Zxcvbnm^%$#@!"
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
MSSQL_ENCRYPT=yes
MSSQL_TRUST_CERT=yes    # set to no once the server has a trusted certificate


